layout {

    focus-ring {
        active-color   "#ffb958"
        inactive-color "#121508"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb958"
        inactive-color "#121508"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb958"
        inactive-color "#643f00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb95880"
    }
}

recent-windows {
    highlight {
        active-color "#ffb958"
        urgent-color "#ffb4ab"
    }
}
