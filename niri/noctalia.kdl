layout {

    focus-ring {
        active-color   "#e7c184"
        inactive-color "#16130f"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e7c184"
        inactive-color "#16130f"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e7c184"
        inactive-color "#5c4211"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e7c18480"
    }
}

recent-windows {
    highlight {
        active-color "#e7c184"
        urgent-color "#ffb4ab"
    }
}
