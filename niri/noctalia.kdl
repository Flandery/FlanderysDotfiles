layout {

    focus-ring {
        active-color   "#90cff1"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#90cff1"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#90cff1"
        inactive-color "#004d67"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#90cff180"
    }
}

recent-windows {
    highlight {
        active-color "#90cff1"
        urgent-color "#ffb4ab"
    }
}
